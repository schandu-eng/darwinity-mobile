{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "20.18.0",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "20.18.0",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "APP_ENV": "production"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "node": "20.18.0",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "APP_ENV": "production",
        "GOOGLE_SIGN_IN_ENABLED": "true",
        "GOOGLE_WEB_CLIENT_ID": "423450423541-nfgg16n2fngateufa4ti2ing862hj0gn.apps.googleusercontent.com",
        "GOOGLE_IOS_CLIENT_ID": "423450423541-26cu96c22ph78igapq312of4ft46tmk3.apps.googleusercontent.com",
        "GOOGLE_ANDROID_CLIENT_ID": "423450423541-sf4ff40oopsue98vrmjer9fj6q5lli3n.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json"
      },
      "ios": {
        "appleId": "taniyagupta2704@gmail.com",
        "ascAppId": "6809006189"
      }
    }
  }
}
