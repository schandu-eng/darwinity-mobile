{
  "name": "darwinity-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "NODE_ENV=development expo start",
    "start:dev": "NODE_ENV=development expo start",
    "start:prod": "NODE_ENV=production expo start",
    "android": "NODE_ENV=development expo start --android",
    "android:dev": "NODE_ENV=development expo start --android",
    "android:prod": "NODE_ENV=production expo start --android",
    "ios": "NODE_ENV=development expo start --ios",
    "ios:dev": "NODE_ENV=development expo start --ios",
    "ios:prod": "NODE_ENV=production expo start --ios",
    "web": "expo start --web",
    "update:production": "NODE_ENV=production npx eas-cli update --branch production --message",
    "update:development": "npx eas-cli update --branch development --message",
    "eas:login": "npx eas-cli login",
    "eas:init": "npx eas-cli init",
    "eas:build": "npx eas-cli build",
    "eas:build:android": "npx eas-cli build --platform android --profile production",
    "eas:build:android:preview": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform android --profile preview --non-interactive --no-wait",
    "eas:build:ios": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform ios --profile production",
    "eas:build:ios:submit": "EAS_BUILD_NO_EXPO_GO_WARNING=true npx eas-cli build --platform ios --profile production --auto-submit --no-wait",
    "eas:submit:android": "npx eas-cli submit --platform android --profile production --latest --non-interactive --wait",
    "eas:submit:android:build": "node ./scripts/wait-and-submit-android.mjs --id <EAS_BUILD_ID>",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production --latest --wait",
    "eas:configure": "npx eas-cli build:configure",
    "play:preflight": "node ./scripts/play-release-preflight.mjs",
    "play:handoff": "cat ./scripts/play-store-handoff.txt",
    "appstore:preflight": "node ./scripts/ios-release-preflight.mjs",
    "appstore:handoff": "cat ./scripts/app-store-handoff.txt",
    "google:android-check": "node ./scripts/google-android-oauth-check.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@lottiefiles/dotlottie-react": "^0.17.13",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native/virtualized-lists": "^0.81.5",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@statsig/expo-bindings": "^3.33.3",
    "@tanstack/react-query": "^5.90.16",
    "axios": "^1.13.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.2.3",
    "expo": "~54.0.31",
    "expo-apple-authentication": "^57.0.2",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-av": "^16.0.8",
    "expo-blur": "^55.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-clipboard": "~8.0.1",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "lottie-react-native": "^7.3.4",
    "lucide-react-native": "^1.31.0",
    "mixpanel-react-native": "^3.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.69.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keyboard-controller": "^1.20.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.14.5",
    "react-native-purchases": "^9.15.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "yup": "^1.7.1",
    "zod": "^4.3.4",
    "zustand": "^5.0.9"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "exclude": [
        "study-alarm",
        "focus-shields"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "typescript": "~5.9.2"
  },
  "private": false,
  "description": "Darwinity \u2014 AI-powered study app for iOS and Android (Expo / React Native)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/schandu-eng/darwinity-mobile.git"
  },
  "homepage": "https://www.darwinity.com",
  "bugs": {
    "url": "https://github.com/schandu-eng/darwinity-mobile/issues"
  }
}
